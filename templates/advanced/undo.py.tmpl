    "ping",
}


def is_mutating(command_type: str) -> bool:
    """Check if a command mutates {{PRETTY_DCC}} state.

    Args:
        command_type: Command name (e.g., 'create_node')

    Returns:
        True if command should trigger undo point
    """
    return command_type in MUTATING_COMMANDS


def should_push_undo(command_type: str) -> bool:
    """Determine if undo point should be pushed before command.

    Args:
        command_type: Command name

    Returns:
        True if undo_push should be called before executing
    """
    # Push undo if:
    # 1. Command is mutating AND
    # 2. Command is not explicitly read-only
    return is_mutating(command_type) and command_type not in READ_ONLY_COMMANDS


