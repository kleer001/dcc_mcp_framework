#!/bin/bash
# Bootstrap {{PRETTY_DCC}} MCP - Setup wizard for users
#
# This script:
#   1. Checks prerequisites (Python, git, uv)
#   2. Clones/updates the {{dcc}}-mcp repository
#   3. Installs dependencies via uv
#   4. Installs the MCP addon in {{PRETTY_DCC}}
#   5. Downloads and ingests documentation
#   6. Configures Claude Code (mcp.json)
#   7. Provides next steps

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'  # No Color

log_info() {
    echo -e "${CYAN}ℹ${NC} $1"
}

log_success() {
    echo -e "${GREEN}✓${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

log_error() {
    echo -e "${RED}✗${NC} $1"
}

print_header() {
    echo -e "\n${BOLD}${CYAN}=== $1 ===${NC}\n"
}

# Detect OS
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    OS="linux"
elif [[ "$OSTYPE" == "darwin"* ]]; then
    OS="macos"
elif [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]]; then
    OS="windows"
else
    OS="unknown"
fi

log_info "Detected OS: $OS"

# Clean environment
unset PYTHONHOME
unset PYTHONPATH

print_header "Checking Prerequisites"

# Check Python
if ! command -v python3 &> /dev/null; then
    log_error "Python 3 not found. Please install Python 3.10+"
    exit 1
fi
python_version=$(python3 --version | awk '{print $2}')
log_success "Python $python_version found"

# Check Git
if ! command -v git &> /dev/null; then
    log_error "Git not found. Please install Git"
    exit 1
fi
log_success "Git found"

# Check/Install uv
if ! command -v uv &> /dev/null; then
    log_warning "uv not found. Installing..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    # Add to PATH for this session
    export PATH="$HOME/.cargo/bin:$PATH"
fi
log_success "uv ready"

print_header "Repository Setup"

# Get repo URL and directory
REPO_URL="${REPO_URL:-https://github.com/user/{{dcc}}-mcp.git}"
REPO_DIR="${REPO_DIR:-$HOME/{{dcc}}-mcp}"

if [ -d "$REPO_DIR" ]; then
    log_info "Repository exists at $REPO_DIR"
    log_info "Updating..."
    cd "$REPO_DIR"
    git pull origin main 2>/dev/null || log_warning "Could not pull; using existing code"
else
    log_info "Cloning repository..."
    git clone "$REPO_URL" "$REPO_DIR"
    cd "$REPO_DIR"
fi

log_success "Repository ready: $REPO_DIR"

print_header "Installing Dependencies"

# Install {{dcc}}-mcp and dev dependencies
log_info "Installing {{dcc}}-mcp..."
uv pip install -e ".[dev]" 2>/dev/null || {
    log_error "Failed to install. Check Python version and dependencies"
    exit 1
}
log_success "Dependencies installed"

print_header "Installing {{DCC}} Addon"

# Detect {{DCC}} installation
log_info "Looking for {{PRETTY_DCC}}..."

# {{DCC}}-specific addon installation
# Example (Houdini):
#   cp houdini_addon/* $HFS/houdini/python_panels/
#   cp houdini_addon/* $HOME/.config/houdini/20.0/python_panels/

if [ "$OS" == "linux" ]; then
    {{DCC_ADDON_PATH_LINUX}}
elif [ "$OS" == "macos" ]; then
    {{DCC_ADDON_PATH_MACOS}}
elif [ "$OS" == "windows" ]; then
    {{DCC_ADDON_PATH_WINDOWS}}
fi

log_success "Addon installed"

print_header "Documentation Setup (Optional)"

# Optional: Download and ingest documentation
read -p "Download {{PRETTY_DCC}} documentation for offline search? (y/n) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    log_info "Downloading documentation..."
    # Example: ingest from GitHub
    # python scripts/ingest_docs.py --source github --repo foundry/nuke-docs
    # log_success "Documentation downloaded"
    # log_info "Building search index..."
    # python -m {{dcc}}mcp.rag --build
    log_success "Documentation ingested"
else
    log_warning "Skipped documentation setup (can be done later)"
fi

print_header "Claude Code Configuration"

# Configure mcp.json for Claude Code
MCP_JSON="$HOME/.claude/config/mcp.json"
mkdir -p "$(dirname "$MCP_JSON")"

if [ -f "$MCP_JSON" ]; then
    log_info "Updating existing mcp.json..."
    # TODO: Merge with existing config
else
    log_info "Creating mcp.json..."
    cat > "$MCP_JSON" << 'EOF'
{
  "mcpServers": {
    "{{dcc}}-mcp": {
      "command": "uv",
      "args": [
        "run",
        "-m",
        "{{dcc}}mcp.server"
      ],
      "env": {
        "PYTHONPATH": "$REPO_DIR/src:$PYTHONPATH"
      }
    }
  }
}
EOF
fi

log_success "Claude Code configured: $MCP_JSON"

print_header "Verification"

# Test installation
log_info "Testing installation..."
if python3 -c "from {{dcc}}mcp.server import {{DCC}}MCPServer" 2>/dev/null; then
    log_success "Installation verified"
else
    log_error "Installation test failed. Check logs above."
    exit 1
fi

print_header "Setup Complete!"

echo -e "${GREEN}✓ {{PRETTY_DCC}} MCP is ready!${NC}"
echo -e "\n${BOLD}Next Steps:${NC}"
echo -e "  1. Start {{PRETTY_DCC}} with MCP addon loaded"
echo -e "  2. In Claude Code, configure the {{dcc}}-mcp server"
echo -e "  3. Try a simple command: 'ping'"
echo -e "\n${BOLD}Useful Commands:${NC}"
echo -e "  Run tests:        pytest -m \"not integration\""
echo -e "  Check code:       ruff check ."
echo -e "  Auto-format:      ruff format ."
echo -e "  Build RAG index:  python -m {{dcc}}mcp.rag --build"
echo -e "\n${BOLD}Documentation:${NC}"
echo -e "  Framework:  https://github.com/kleer001/dcc_mcp_framework"
echo -e "  This repo:  $REPO_DIR/README.md"
echo -e "\n${BOLD}Support:${NC}"
echo -e "  Issues:     https://github.com/user/{{dcc}}-mcp/issues"
echo -e "  Docs:       $REPO_DIR/BESTPRACTICES.md"

log_success "Bootstrap complete!"
